# Salin ke .env.local lalu sesuaikan. Variabel NEXT_PUBLIC_* ikut terbawa ke browser,
# jadi JANGAN taruh rahasia (API key, JWT secret) di sini.

# URL backend CardBus, sama dengan ApiService.defaultBaseUrl di aplikasi mobile.
# Development dengan backend lokal: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=https://cardbusbackend-production.up.railway.app

# Batas waktu request ke backend (ms). Mobile memakai 15 detik.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Interval cek status pembayaran (ms) di halaman pesanan.
NEXT_PUBLIC_PAYMENT_POLL_MS=5000

# Nomor WhatsApp CS (format 62xxx) untuk tombol "Hubungi CS".
NEXT_PUBLIC_CS_WHATSAPP=

# --- Login Google (Firebase Auth) ---
# Project Firebase sama dengan aplikasi mobile: cardbus-d6aa5.
# apiKey & appId didapat setelah mendaftarkan aplikasi WEB di Firebase Console:
#   Project settings → General → Your apps → Add app → Web (</>) → salin firebaseConfig.
# Tombol "Masuk dengan Google" baru muncul jika API_KEY, APP_ID, dan PROJECT_ID terisi.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cardbus-d6aa5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cardbus-d6aa5
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=659374502720
